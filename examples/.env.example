# 复制为 examples/.env，执行 chmod 600 examples/.env，再填入自己的订阅链接。
# 填写后的 .env 包含访问令牌，请保留在本机，不要提交到 Git。
TAISHAN_SUB_URL=https://example.invalid/subscription?token=REPLACE_ME
COKECLOUD_SUB_URL=https://example.invalid/subscription?token=REPLACE_ME
# 可选：填入 API key 后，程序会检查 Realtime API 会话能否保持连接、断开后能否重连。
OPENAI_API_KEY=
